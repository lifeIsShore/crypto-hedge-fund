# .env.example — copy to .env and fill in values, never commit .env

# --- PRIMARY API (MARKET DATA / BROKER) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- BACKUP APIs ---
FRED_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- FX FALLBACKS ---
FALLBACK_USDEUR=0.92
FALLBACK_GBPEUR=1.17

# --- ALERTING & NOTIFICATIONS ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_EMAIL_TO=

# --- DASHBOARD AUTH ---
# Set this to a long random string to require a token on write endpoints
# (log_trade, override, label, sync_ledger). Leave blank = open (dev mode).
DASHBOARD_SECRET=

# --- FLASK ---
# Only set to 1 when actively debugging locally. Never 1 in a hosted/customer-facing instance.
FLASK_DEBUG=0

# --- DATABASE ---
# DATABASE_URL=sqlite:///c:/Users/ahmty/Desktop/hedge-fund/engine_data.db
